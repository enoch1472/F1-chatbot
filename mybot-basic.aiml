  <template>#50$<star/></template></category>
<category><pattern>HOW LIKELY SKILL * EXPERIENCE *</pattern>
  <template>#51$skill <star index="1"/> experience <star index="2"/></template></category>
<category><pattern>HOW LIKELY * SKILL * EXPERIENCE *</pattern>
  <template>#51$skill <star index="2"/> experience <star index="3"/></template></category>
<category><pattern>TELL ME ABOUT *</pattern>
  <template>#99$<star/></template></category>
<category><pattern>WHO DRIVES FOR *</pattern>
  <template>#99$who drives for <star/></template></category>
<category><pattern>WHAT TEAM IS * ON</pattern>
  <template>#99$what team is <star/> on</template></category>
<category><pattern>WHO WON THE * GRAND PRIX</pattern>
  <template>#99$who won the <star/> grand prix</template></category>
<category><pattern>WHEN DID * WIN THE CHAMPIONSHIP</pattern>
  <template>#99$when did <star/> win the championship</template></category>
<category><pattern>WHERE IS THE * GRAND PRIX HELD</pattern>
  <template>#99$where is the <star/> grand prix held</template></category>
<category><pattern>EXPLAIN * TO ME</pattern>
  <template>#99$<star/></template></category>
<category><pattern>COMPARE * AND *</pattern>
  <template>#99$compare <star index="1"/> and <star index="2"/></template></category>
